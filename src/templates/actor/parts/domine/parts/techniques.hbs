{{#> "systems/animabf/templates/common/ui/group.hbs"
  class="techniques"
}}
  {{>
  "systems/animabf/templates/common/ui/group-header.hbs"
    title=(localize "anima.ui.domine.techniques.title")
  }}
  {{#> "systems/animabf/templates/common/ui/group-body.hbs"
    class="techniques"
  }}
    <div class="technique-cards">
      {{#each @root.kiTechniques}}
        <div class="technique-card{{#if active}} technique-card--active{{/if}}{{#if freshTurn}} technique-card--undoable{{/if}}{{#unless computed.isValid}} technique-card--invalid{{/unless}}" data-technique-id="{{id}}"{{#if freshTurn}} title="Click derecho: Deshacer este asalto y recuperar el Ki"{{/if}}>
          <div class="technique-card-head">
            <span class="technique-card-name">{{name}}{{#if active}} <span class="technique-card-badge">Activa{{#if isSostenida}} · {{remaining}} asaltos{{/if}}</span>{{else}}{{#if freshTurn}} <span class="technique-card-badge">Este asalto</span>{{/if}}{{/if}}</span>
            <span class="technique-card-cm">CM {{computed.cmTotal}}</span>
          </div>
          <div class="technique-card-sub">
            <span class="technique-card-coste">{{costString}}</span>
            <span class="technique-card-level">Nivel: {{computed.level}}</span>
          </div>
          {{#if effectsSummary}}
            <div class="technique-card-effects">{{effectsSummary}}</div>
          {{/if}}
          {{#if appliedBonuses.length}}
            <div class="technique-card-applied{{#if active}} is-active{{/if}}">Aplica: {{appliedBonusesString}}</div>
          {{/if}}
          <div class="technique-card-actions">
            <span class="technique-card-ki">Coste total de Ki: {{kiActiveTotal}}{{#if isMantenida}} · mant {{kiMaintTotal}}/asalto{{/if}}</span>
            {{#if isInstant}}
              {{#if freshTurn}}
                <span class="technique-status technique-status--used">Usando…</span>
              {{else}}
                <button type="button" class="technique-use" data-action="tech-use">Usar</button>
              {{/if}}
            {{else}}
              {{#if active}}
                <span class="technique-status technique-status--used">Usando…</span>
                <button type="button" class="technique-deactivate" data-action="tech-deactivate">Desactivar</button>
              {{else}}
                <button type="button" class="technique-activate" data-action="tech-activate">Activar</button>
              {{/if}}
            {{/if}}
          </div>
        </div>
      {{else}}
        <p class="technique-cards-empty">
          No hay técnicas. Créalas en la pestaña «Creación de Técnicas de Ki».
        </p>
      {{/each}}
    </div>
  {{/"systems/animabf/templates/common/ui/group-body.hbs"}}
{{/"systems/animabf/templates/common/ui/group.hbs"}}
