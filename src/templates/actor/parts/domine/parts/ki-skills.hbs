{{#> "systems/animabf/templates/common/ui/group.hbs"
  class="ki-skills"
}}
  {{>
  "systems/animabf/templates/common/ui/group-header.hbs"
    title=(localize "anima.ui.domine.kiSkills.title")
    addRowButtonData="add-ki-skill"
  }}
  {{#> "systems/animabf/templates/common/ui/group-body.hbs"
    class="ki-skills"
  }}
    {{#each system.domine.kiSkills as |kiSkill index|}}
      <div data-item-id='{{kiSkill._id}}' class='ki-skill-row'>
        {{>
        "systems/animabf/templates/common/ui/vertical-titled-input.hbs"
          class="name"
          title=(localize "anima.ui.domine.kiSkills.name.title")
          hideTitle=(is "gt" index 0)
          inputType="text"
          inputName=(concat "system.dynamic.kiSkills." kiSkill._id ".name")
          inputValue=kiSkill.name
        }}
        {{>
        "systems/animabf/templates/common/ui/vertical-titled-input.hbs"
          class="martial-knowledge"
          title=(localize "anima.ui.domine.kiSkills.martialKnowledge.title")
          hideTitle=(is "gt" index 0)
          inputType="number"
          inputName=(concat "system.dynamic.kiSkills." kiSkill._id ".system.martialKnowledge.value")
          inputValue=kiSkill.system.martialKnowledge.value
        }}
      </div>
    {{/each}}
  {{/"systems/animabf/templates/common/ui/group-body.hbs"}}
{{/"systems/animabf/templates/common/ui/group.hbs"}}
