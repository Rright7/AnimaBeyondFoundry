      <p class='label accumulation-row-title'>{{localize "anima.ui.domine.kiAccumulation.strength.title"}}</p>

      {{>
      "systems/animabf/templates/common/ui/horizontal-titled-input.hbs"
        class="strength-accumulation accumulation-row-accumulation"
        hideTitle=true
        disabled=true
        inputName="system.domine.kiAccumulation.strength.final.value"
        inputValue=system.domine.kiAccumulation.strength.final.value
      }}

      {{>
      "systems/animabf/templates/common/ui/horizontal-titled-input.hbs"
        class="strength-bonus accumulation-row-bonus"
        hideTitle=true
        inputName="system.domine.kiAccumulation.strength.bonus.value"
        inputValue=system.domine.kiAccumulation.strength.bonus.value
      }}

      {{>
      "systems/animabf/templates/common/ui/horizontal-titled-input.hbs"
        class="current-strength-reserve accumulation-row-reserve"
        hideTitle=true
        inputName="system.domine.kiAccumulation.strength.accumulated.value"
        inputValue=system.domine.kiAccumulation.strength.accumulated.value
      }}
    </div>
