        inputValue=system.domine.kiAccumulation.power.bonus.value
      }}

      {{>
      "systems/animabf/templates/common/ui/horizontal-titled-input.hbs"
        class="current-power-reserve accumulation-row-reserve"
        hideTitle=true
        inputName="system.domine.kiAccumulation.power.accumulated.value"
        inputValue=system.domine.kiAccumulation.power.accumulated.value
      }}
    </div>
    <div class='accumulation-row generic-accumulation-row ki-reserve-row'>
      <p class='label accumulation-row-title'>{{localize "anima.ui.domine.kiAccumulation.reserve.title"}}</p>
      <div class="ki-reserve-fields">
        <label class="ki-reserve-field" title="Reserva actual (se gasta al usar/mantener técnicas)">
          <span>Actual</span>
          <input type="number" data-dtype="Number"
            name="system.domine.kiAccumulation.reserve.current.value"
            value="{{system.domine.kiAccumulation.reserve.current.value}}">
        </label>
        <label class="ki-reserve-field" title="Modificador de reserva (artefactos/extra: suma o resta al total)">
          <span>Mod.</span>
          <input type="number" data-dtype="Number"
            name="system.domine.kiAccumulation.reserve.modifier.value"
            value="{{system.domine.kiAccumulation.reserve.modifier.value}}">
        </label>
        <label class="ki-reserve-field" title="Reserva total (ΣPuntos de Ki + Mod.). Editable: ajusta el modificador.">
          <span>Máx.</span>
          <input type="number" data-action="ki-reserve-max"
            value="{{system.domine.kiAccumulation.reserve.max.value}}">
        </label>
      </div>
    </div>
    <div class='ki-charge-controls'>
      <div class="ki-charge-row">
        <button type="button" class="ki-charge-btn{{#if @root.kiCharging}} is-active{{/if}}"
          data-action="ki-charge">
          {{#if @root.kiCharging}}Cargando Ki…{{else}}Cargar Ki{{/if}}
        </button>
        <span class="ki-accumulated-total" title="Ki concentrado total (suma de 'Ki acu.')">Concentrado: {{@root.kiAccumulatedTotal}}</span>
      </div>
      <label class="ki-full-accumulation" title="Si está marcado, las acumulaciones no se reducen a la mitad al pasar el asalto.">
        <input type="checkbox" data-action="ki-full-accumulation"
          {{#if @root.kiFullAccumulation}}checked{{/if}}>
        <span>Acumulación plena</span>
      </label>
      <div class="ki-accumulate-select" title="Marca qué características se acumulan al cargar Ki">
        <span class="ki-accumulate-select-label">Acumular:</span>
        <label title="Fuerza"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.strength.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.strength.accumulating.value false)}}checked{{/unless}}><span>FUE</span></label>
        <label title="Agilidad"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.agility.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.agility.accumulating.value false)}}checked{{/unless}}><span>AGI</span></label>
        <label title="Destreza"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.dexterity.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.dexterity.accumulating.value false)}}checked{{/unless}}><span>DES</span></label>
        <label title="Constitución"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.constitution.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.constitution.accumulating.value false)}}checked{{/unless}}><span>CON</span></label>
        <label title="Voluntad"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.willPower.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.willPower.accumulating.value false)}}checked{{/unless}}><span>VOL</span></label>
        <label title="Poder"><input type="checkbox" data-dtype="Boolean" name="system.domine.kiAccumulation.power.accumulating.value" {{#unless (is 'eq' system.domine.kiAccumulation.power.accumulating.value false)}}checked{{/unless}}><span>POD</span></label>
      </div>
    </div>
  {{/"systems/animabf/templates/common/ui/group-body.hbs"}}
{{/"systems/animabf/templates/common/ui/group.hbs"}}
