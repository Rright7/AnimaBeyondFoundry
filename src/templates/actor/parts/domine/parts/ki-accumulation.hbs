  class="ki-accumulation"
}}
  {{#>
  "systems/animabf/templates/common/ui/group-header.hbs"
  }}
    <p class='label accumulation'>{{localize "anima.ui.domine.kiAccumulation.accumulation.title"}}</p>
    <p class='label bonus' title="Bono de Acumulacion (ventaja 'Aumento de la Acumulacion de Ki' o regla de la casa): se suma a la de tabla">Bono</p>
    <p class='label title'>{{localize "anima.ui.domine.kiAccumulation.title"}}</p>
  {{/"systems/animabf/templates/common/ui/group-header.hbs"}}
