{{#> 'systems/animabf/templates/common/ui/custom-select.hbs'
  isVertical=this.isVertical
  hideTitle=this.hideTitle
  class=this.class
  title=this.title
  inputName=this.inputName
}}
  <option {{#if (is "eq" this.inputValue 'none')}}selected{{/if}} value='none'>{{localize 'anima.ui.combat.weapons.handSlot.none'}}</option>
  <option {{#if (is "eq" this.inputValue 'main')}}selected{{/if}} value='main'>{{localize 'anima.ui.combat.weapons.handSlot.main'}}</option>
  <option {{#if (is "eq" this.inputValue 'off')}}selected{{/if}} value='off'>{{localize 'anima.ui.combat.weapons.handSlot.off'}}</option>
{{/'systems/animabf/templates/common/ui/custom-select.hbs'}}
