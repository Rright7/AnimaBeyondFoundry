{{#> "systems/animabf/templates/common/ui/group.hbs"
  class="animabf-chat-message attack-data-message"
  contractible=true
  contractibleItemId="chat-attack-data"
}}
  {{>
    "systems/animabf/templates/common/ui/group-header.hbs"
    title=(localize "chat.attackData.title")
  }}

  {{#> "systems/animabf/templates/common/ui/group-body.hbs"}}
    {{!-- <p><strong>{{localize "anima.ui.combat.weapons.attack.title"}}:</strong> {{weapon.system.attack.final.value}}</p> --}}
    <p data-requires-permission="owner"><strong>{{localize "anima.ui.combat.weapons.attack.title"}}:</strong> {{attackData.attackAbility}}</p>
    <p data-requires-permission="owner"><strong>{{localize "anima.ui.combat.weapons.damage.final.title"}}:</strong> {{attackData.damage}}</p>
    {{#if attackData.critDamageBonus}}
      <p data-requires-permission="owner"><strong>{{localize "macros.combat.dialog.critDamageBonus.title"}}:</strong> {{attackData.critDamageBonus}}</p>
    {{/if}}
    {{#if attackData.automaticCrit}}
      <p data-requires-permission="owner"><strong>{{localize "macros.combat.dialog.automaticCrit.title"}}</strong></p>
    {{/if}}
    {{#if attackData.resistanceEffect.check}}
      <p><strong>{{localize "chat.attackData.resistanceRequired"}}:</strong> {{localize (concat "chat.attackData.resistanceType." attackData.resistanceEffect.type)}} {{attackData.resistanceEffect.value}}</p>
    {{/if}}
    {{!-- <p><strong>{{localize "anima.ui.combat.weapons.block.title"}}:</strong> {{weapon.system.block.final.value}}</p> --}}
    {{!-- <p><strong>{{localize "anima.ui.combat.weapons.presence.final.title"}}:</strong> {{weapon.system.presence.final.value}}</p> --}}
  

    <div class="attack-actions-row">
      <button
        type="button"
        class="chat-action-button"
        data-action="defend"
        data-message-id="{{xRoot.messageId}}"
        data-weapon-id="{{weapon._id}}"
        data-attack-data='{{json attackData}}'>
        {{localize "chat.attackData.defendButton"}}
      </button>

      <button
        type="button"
        class="chat-action-button"
        data-action="auto-defend"
        data-message-id="{{xRoot.messageId}}"
        data-attack-data='{{json attackData}}'>
        {{localize "chat.attackData.autoDefendButton"}}
      </button>

      <button
        type="button"
        class="chat-action-button"
        data-action="auto-defend-pending"
        data-message-id="{{xRoot.messageId}}"
        data-attack-data='{{json attackData}}'>
        {{localize "chat.attackData.autoDefendPendingButton"}}
      </button>

      {{#if attackData.resistanceEffect.check}}
        <button
          type="button"
          class="chat-action-button"
          data-action="resist"
          data-message-id="{{xRoot.messageId}}"
          data-attack-data='{{json attackData}}'>
          {{localize "chat.attackData.resistButton"}}
        </button>
      {{/if}}

    </div>

    {{#if attackData.areaRadius}}
      <div class="attack-area-row">
        <button
          type="button"
          class="chat-action-button place-area-button"
          data-action="place-area-template"
          data-message-id="{{xRoot.messageId}}"
          data-radius="{{attackData.areaRadius}}"
          data-attacker-id="{{attackData.attackerId}}">
          <i class="fas fa-bullseye"></i>
          <span>{{localize "chat.attackData.placeAreaButton"}} ({{attackData.areaRadius}} m)</span>
        </button>
      </div>
    {{/if}}
    <div id="animabf-defense-row-{{xRoot.messageId}}"
       class="animabf-defense-row"
       style="margin-top:.5rem; display:flex; gap:.25rem; flex-wrap:wrap;">
    </div>
    {{/"systems/animabf/templates/common/ui/group-body.hbs"}}
{{/"systems/animabf/templates/common/ui/group.hbs"}}
